# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# The model release asset (scripts/build-model-asset.mjs) and the icon eval's cached vectors:
# model weights and anything built from the game's art are never committed.
dist-model
.icon-eval

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build output
src-tauri/target
src-tauri/gen
scripts/dev/.out

# Regenerable / large data (see README "Data refresh")
data/gamedata/raw
data/gamedata/strings
tools/vendor
tools/datamine/bin
tools/datamine/cascx/obj
# cascx.exe sidecar: built from source by tools/datamine/build-cascx.mjs (and by CI)
src-tauri/bin
release

# Raw dumps — regenerate with the scripts in scripts/ and tools/datamine.
# The app only ships the slimmed copies in src/generated/.
data/builds
data/static
data/gamedata/*
!data/gamedata/README.md
research/samples
*.tsbuildinfo

# Local agent worktrees and scratch build output
.claude/
src-tauri/target-*/

# Personal notes and drafts, never committed
private/

# Cloudflare Worker local state and dev secrets
worker/.wrangler
worker/.dev.vars

# rust-analyzer / cargo output when the editor builds from the repo root
/target/
